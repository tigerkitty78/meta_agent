# Meta Marketing / Insights API credentials
# Copy this file to ".env" and fill in your real values.

# A long-lived System User or User access token with ads_read (and ads_management
# later, for write actions). Never commit the real .env.
META_ACCESS_TOKEN=your_long_lived_access_token_here

# Ad account ID. Include the "act_" prefix, e.g. act_1234567890
META_AD_ACCOUNT_ID=act_XXXXXXXXXX

# Graph API version to target.
META_API_VERSION=v21.0

# Optional: default attribution windows used when requesting insights.
# Meta's action_attribution_windows values, comma separated.
# Common choice: 7d_click,1d_view  (matches meta_roas_7d_click_1d_view naming)
META_ATTRIBUTION_WINDOWS=7d_click,1d_view

# Path to the economics / targets config (defaults to config/economics.yaml).
NUTRISULIN_CONFIG=config/economics.yaml
